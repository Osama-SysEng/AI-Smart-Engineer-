# AI Smart Engineer local configuration template
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Database - use a local secret manager or chmod 600 .env; never commit real values
DATABASE_URL=postgresql+asyncpg://smart_engineer:replace-with-local-password@localhost:5432/smart_engineer
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0

# Application signing; generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-48-random-characters
JWT_ISSUER=ai-smart-engineer
JWT_AUDIENCE=ai-smart-engineer-api

# LLM: select only configured providers; keep keys server-side
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
FALLBACK_PROVIDER=local
LOCAL_MODEL_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
AI_COST_LIMIT_DAILY=100
AI_COST_LIMIT_MONTHLY=2000

# SAP: read-only and dry-run by default; OAuth client credentials are preferred
SAP_HOST=
SAP_PORT=8000
SAP_CLIENT=100
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TOKEN_URL=
SAP_ALLOWED_HOSTS=
SAP_READ_ONLY=true
SAP_DRY_RUN=true
SAP_MOCK_MODE=true
SAP_TIMEOUT_SECONDS=10

# Storage and monitoring
STORAGE_TYPE=local
STORAGE_PATH=./storage
SENTRY_DSN=
